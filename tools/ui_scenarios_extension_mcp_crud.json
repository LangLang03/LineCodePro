{
  "settle_seconds": 0.8,
  "launch_settle_seconds": 0.8,
  "locale": "zh-CN",
  "setup": [
    {"type": "sleep", "seconds": 1.0},
    {"type": "tap_text", "value": "同意", "optional": true},
    {"type": "sleep", "seconds": 1.0}
  ],
  "scenarios": [
    {
      "name": "mcp_create",
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "添加 HTTP/S MCP"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_labeled_editable", "label": "名称"},
        {"type": "text", "value": "ParityMCP"},
        {"type": "sleep", "seconds": 0.2},
        {"type": "expect_labeled_editable_text", "label": "名称", "value": "ParityMCP"},
        {"type": "tap_labeled_editable", "label": "HTTP/S 地址"},
        {"type": "text", "value": "http://127.0.0.1:18765/mcp"},
        {"type": "sleep", "seconds": 0.2},
        {"type": "expect_labeled_editable_text", "label": "HTTP/S 地址", "value": "http://127.0.0.1:18765/mcp"},
        {"type": "keyevent", "key": 4},
        {"type": "tap_text", "value": "添加请求头"},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_editable", "index": 2},
        {"type": "text", "value": "X-Parity"},
        {"type": "sleep", "seconds": 0.2},
        {"type": "expect_editable_text", "index": 2, "value": "X-Parity"},
        {"type": "tap_editable", "index": 3},
        {"type": "text", "value": "token"},
        {"type": "sleep", "seconds": 0.2},
        {"type": "expect_editable_text", "index": 3, "value": "token"},
        {"type": "keyevent", "key": 4},
        {"type": "tap_text", "value": "查询 MCP 列表"},
        {"type": "sleep", "seconds": 2.0},
        {"type": "expect_text", "value": "parity_echo"},
        {"type": "expect_text", "value": "parity_status"},
        {"type": "tap_control_after_text", "label": "parity_status", "class": "android.widget.Switch"},
        {"type": "sleep", "seconds": 0.4},
        {"type": "expect_control_checked", "label": "parity_status", "class": "android.widget.Switch", "value": false},
        {"type": "tap_text", "value": "保存"},
        {"type": "sleep", "seconds": 1.5},
        {"type": "expect_text", "value": "已安装"},
        {"type": "expect_text", "value": "ParityMCP"},
        {"type": "expect_text", "value": "2 tools · http://127.0.0.1:18765/mcp"}
      ]
    },
    {
      "name": "mcp_reload",
      "depends_on": ["mcp_create"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_text", "value": "ParityMCP"},
        {"type": "expect_control_checked", "label": "ParityMCP", "class": "android.widget.Switch", "value": true}
      ]
    },
    {
      "name": "mcp_edit",
      "depends_on": ["mcp_reload"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "long_press_text", "value": "ParityMCP"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "修改"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_labeled_editable_text", "label": "名称", "value": "ParityMCP"},
        {"type": "expect_labeled_editable_text", "label": "HTTP/S 地址", "value": "http://127.0.0.1:18765/mcp"},
        {"type": "expect_editable_text", "index": 2, "value": "X-Parity"},
        {"type": "expect_editable_text", "index": 3, "value": "token"},
        {"type": "expect_text", "value": "parity_status"},
        {"type": "expect_control_checked", "label": "parity_status", "class": "android.widget.Switch", "value": false},
        {"type": "tap_labeled_editable", "label": "名称"},
        {"type": "text", "value": "Edited"},
        {"type": "sleep", "seconds": 0.2},
        {"type": "expect_labeled_editable_text", "label": "名称", "value": "ParityMCPEdited"},
        {"type": "keyevent", "key": 4},
        {"type": "tap_text", "value": "保存"},
        {"type": "sleep", "seconds": 1.2},
        {"type": "expect_text", "value": "ParityMCPEdited"}
      ]
    },
    {
      "name": "mcp_disable",
      "depends_on": ["mcp_edit"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_control_checked", "label": "ParityMCPEdited", "class": "android.widget.Switch", "value": true},
        {"type": "tap_control_after_text", "label": "ParityMCPEdited", "class": "android.widget.Switch"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_control_checked", "label": "ParityMCPEdited", "class": "android.widget.Switch", "value": false}
      ]
    },
    {
      "name": "mcp_disable_reload",
      "depends_on": ["mcp_disable"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_control_checked", "label": "ParityMCPEdited", "class": "android.widget.Switch", "value": false}
      ]
    },
    {
      "name": "mcp_delete",
      "depends_on": ["mcp_disable_reload"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "long_press_text", "value": "ParityMCP", "contains": true},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "删除"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "删除扩展"},
        {"type": "tap_text", "value": "删除"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_no_text", "value": "ParityMCP"},
        {"type": "expect_text", "value": "还没有添加 MCP。"}
      ]
    },
    {
      "name": "mcp_delete_reload",
      "depends_on": ["mcp_delete"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "MCP 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_no_text", "value": "ParityMCP"},
        {"type": "expect_text", "value": "还没有添加 MCP。"}
      ]
    }
  ]
}
