{
  "settle_seconds": 1.0,
  "launch_settle_seconds": 0.8,
  "locale": "zh-CN",
  "pixel_masks": [[0, 0, 180, 90]],
  "setup": [
    {"type": "sleep", "seconds": 1.0},
    {"type": "tap_text", "value": "同意", "optional": true},
    {"type": "sleep", "seconds": 1.0}
  ],
  "scenarios": [
    {
      "name": "llm_settings",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "AI 行为"},
        {"type": "sleep", "seconds": 0.7},
        {"type": "expect_text", "value": "思考深度"},
        {"type": "expect_text", "value": "学习模式"}
      ]
    },
    {
      "name": "output_settings",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "输出与浏览"},
        {"type": "sleep", "seconds": 0.7},
        {"type": "expect_text", "value": "Markdown 预览"},
        {"type": "expect_text", "value": "LineCode"}
      ]
    },
    {
      "name": "storage",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "swipe", "x1": 540, "y1": 2100, "x2": 540, "y2": 450, "duration_ms": 700},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "聊天、配置、diff 和工作区占用"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "Diff 缓存"},
        {"type": "expect_text", "value": "Home 目录"}
      ]
    },
    {
      "name": "error_logs",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "swipe", "x1": 540, "y1": 2100, "x2": 540, "y2": 450, "duration_ms": 700},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "查看完整错误堆栈、HTTP 请求和响应"},
