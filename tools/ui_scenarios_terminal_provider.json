{
  "settle_seconds": 1.0,
  "launch_settle_seconds": 0.8,
  "locale": "zh-CN",
  "pixel_masks": [[0, 0, 180, 90]],
  "setup": [
    {"type": "sleep", "seconds": 1.0},
    {"type": "tap_text", "value": "同意", "optional": true},
    {"type": "sleep", "seconds": 1.0}
  ],
  "scenarios": [
    {
      "name": "terminal_provider_default",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "终端提供者"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_text", "value": "扫描可用的终端提供者应用"},
        {"type": "expect_text", "value": "已安装"},
        {"type": "expect_text", "value": "尚未添加终端提供者。"}
      ]
    },
    {
      "name": "terminal_provider_scan",
      "depends_on": ["terminal_provider_default"],
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "终端提供者"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "扫描可用的终端提供者应用"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "扫描结果"},
        {"type": "expect_text", "value": "Terminal Provider"},
        {"type": "expect_text", "value": "cn.lineai.terminalprovider"}
      ]
    },
    {
      "name": "terminal_provider_add_sheet",
      "depends_on": ["terminal_provider_scan"],
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "终端提供者"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "扫描可用的终端提供者应用"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "tap_text", "value": "Terminal Provider"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "添加「Terminal Provider」？"},
        {"type": "expect_text", "value": "此应用将用于执行 Shell 命令和传输文件"}
      ]
    },
    {
      "name": "terminal_provider_installed",
      "depends_on": ["terminal_provider_add_sheet"],
      "relaunch": false,
      "actions": [
        {"type": "tap_text", "value": "添加"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "Terminal Provider"},
        {"type": "expect_text", "value": "cn.lineai.terminalprovider"},
        {"type": "expect_no_text", "value": "尚未添加终端提供者。"}
      ]
    },
    {
      "name": "terminal_provider_delete_sheet",
      "depends_on": ["terminal_provider_installed"],
      "relaunch": false,
      "actions": [
        {"type": "long_press_text", "value": "Terminal Provider", "after": "已安装"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "删除终端提供者"},
        {"type": "expect_text", "value": "删除「Terminal Provider」？"}
      ]
    },
    {
      "name": "terminal_provider_deleted",
      "depends_on": ["terminal_provider_delete_sheet"],
      "compare_pixels": false,
      "relaunch": false,
      "actions": [
        {"type": "tap_text", "value": "删除"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "尚未添加终端提供者。"}
      ]
    }
  ]
}
