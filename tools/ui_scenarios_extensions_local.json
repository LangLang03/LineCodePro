{
  "settle_seconds": 1.0,
  "launch_settle_seconds": 0.8,
  "locale": "zh-CN",
  "pixel_masks": [[0, 0, 180, 90]],
  "setup": [
    {"type": "sleep", "seconds": 1.0},
    {"type": "tap_text", "value": "同意", "optional": true},
    {"type": "sleep", "seconds": 1.0}
  ],
  "scenarios": [
    {
      "name": "extensions_skills_detail",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Skills 扩展"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "创建或安装 SKILL"},
        {"type": "expect_text", "value": "SkillHub Skill 商店"},
        {"type": "expect_text", "value": "分享工作区目录"},
        {"type": "expect_text", "value": "已安装"}
      ]
    },
    {
      "name": "extensions_skills_actions",
      "depends_on": ["extensions_skills_detail"],
      "relaunch": false,
      "actions": [
        {"type": "tap_text", "value": "创建或安装 SKILL"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "Skills"},
        {"type": "expect_text", "value": "选择 ZIP / SKILL.md 安装"},
        {"type": "expect_text", "value": "从 GitHub 安装"},
        {"type": "expect_text", "value": "创建 SKILL"},
        {"type": "expect_text", "value": "从本地路径安装"}
      ]
    },
    {
      "name": "extensions_skills_create",
      "depends_on": ["extensions_skills_actions"],
      "relaunch": false,
      "compare_pixels": false,
      "actions": [
        {"type": "tap_text", "value": "创建 SKILL"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_labeled_editable", "label": "名称"},
        {"type": "text", "value": "ParitySkill"},
        {"type": "expect_labeled_editable_text", "label": "名称", "value": "ParitySkill"},
        {"type": "keyevent", "key": 4},
        {"type": "sleep", "seconds": 0.2},
        {"type": "tap_text", "value": "全局"},
        {"type": "tap_text", "value": "创建"},
        {"type": "sleep", "seconds": 1.5},
        {"type": "expect_text", "value": "ParitySkill"}
      ]
    },
    {
      "name": "extensions_skills_cold_reload",
      "depends_on": ["extensions_skills_create"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Skills 扩展"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "ParitySkill"},
        {"type": "expect_control_checked", "label": "ParitySkill", "class": "android.widget.Switch", "value": true}
      ]
    },
    {
      "name": "extensions_skills_disable",
      "depends_on": ["extensions_skills_cold_reload"],
      "relaunch": false,
      "compare_pixels": false,
      "actions": [
        {"type": "tap_control_after_text", "label": "ParitySkill", "class": "android.widget.Switch"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_control_checked", "label": "ParitySkill", "class": "android.widget.Switch", "value": false}
      ]
    },
    {
      "name": "extensions_skills_disabled_reload",
      "depends_on": ["extensions_skills_disable"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Skills 扩展"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_control_checked", "label": "ParitySkill", "class": "android.widget.Switch", "value": false}
      ]
    },
    {
      "name": "extensions_skills_delete_sheet",
      "depends_on": ["extensions_skills_disabled_reload"],
      "relaunch": false,
      "compare_pixels": false,
      "actions": [
        {"type": "long_press_text", "value": "ParitySkill"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "已选 1 项"},
        {"type": "tap_text", "value": "删除"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "删除所选"},
        {"type": "expect_text", "value": "确定删除已选的 1 项？"}
      ]
    },
    {
      "name": "extensions_skills_deleted",
      "depends_on": ["extensions_skills_delete_sheet"],
      "relaunch": false,
      "compare_pixels": false,
      "actions": [
        {"type": "tap_text", "value": "删除"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_no_text", "value": "ParitySkill"}
      ]
    },
    {
      "name": "extensions_linecode_detail",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "Agent、MCP、Skills 和 LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "tap_text", "value": "LineCode 扩展"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_text", "value": "导入 LIP 扩展"},
        {"type": "expect_text", "value": "LineCode 扩展后续接入。"},
        {"type": "expect_text", "value": "已安装"}
      ]
    },
    {
      "name": "extensions_linecode_unavailable",
      "depends_on": ["extensions_linecode_detail"],
      "compare_pixels": false,
      "relaunch": false,
      "actions": [
        {"type": "tap_text", "value": "导入 LIP 扩展"},
        {"type": "sleep", "seconds": 0.2},
        {"type": "expect_text", "value": "LineCode 扩展后续接入。"}
      ]
    }
  ]
}
