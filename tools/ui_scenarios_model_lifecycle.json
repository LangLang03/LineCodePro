{
  "settle_seconds": 1.0,
  "launch_settle_seconds": 0.8,
  "locale": "zh-CN",
  "pixel_masks": [[0, 0, 180, 90]],
  "setup": [
    {"type": "sleep", "seconds": 1.0},
    {"type": "tap_text", "value": "同意", "optional": true},
    {"type": "sleep", "seconds": 1.0}
  ],
  "scenarios": [
    {
      "name": "model_probe_dialog",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "自定义模型"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_labeled_editable", "label": "名称"},
        {"type": "text", "value": "ProbeModel"},
        {"type": "tap_labeled_editable", "label": "Base URL"},
        {"type": "text", "value": "http://10.0.2.2:18080/v1"},
        {"type": "tap_labeled_editable", "label": "API Key"},
        {"type": "text", "value": "test-key"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_control_after_text", "label": "自定义", "class": "android.widget.Switch"},
        {"type": "expect_control_checked", "label": "自定义", "class": "android.widget.Switch", "value": true},
        {"type": "tap_labeled_editable", "label": "模型 ID"},
        {"type": "text", "value": "linecode-test-model"},
        {"type": "expect_labeled_editable_text", "label": "模型 ID", "value": "linecode-test-model"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_text", "value": "测试"},
        {"type": "wait_for_text", "value": "测试结果", "timeout_seconds": 12.0},
        {"type": "expect_text", "value": "测试结果"},
        {"type": "expect_text", "value": "原始响应："},
        {"type": "expect_text", "value": "这是 LineCode 自动化测试的固定回复。"},
        {"type": "expect_text", "value": "取消"},
        {"type": "expect_text", "value": "确定"}
      ]
    },
    {
      "name": "model_catalog_picker",
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "自定义模型"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_labeled_editable", "label": "Base URL"},
        {"type": "text", "value": "http://10.0.2.2:18080/v1"},
        {"type": "tap_labeled_editable", "label": "API Key"},
        {"type": "text", "value": "test-key"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_text", "value": "查询"},
        {"type": "wait_for_text", "value": "测试失败：", "timeout_seconds": 12.0},
        {"type": "expect_text", "value": "选择模型"},
        {"type": "expect_text", "value": "linecode-test-model"},
        {"type": "expect_text", "value": "自定义 ID…"}
      ]
    },
    {
      "name": "model_probe_failure_toast",
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "自定义模型"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_labeled_editable", "label": "Base URL"},
        {"type": "text", "value": "http://10.0.2.2:18080/missing/v1"},
        {"type": "tap_labeled_editable", "label": "API Key"},
        {"type": "text", "value": "test-key"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_control_after_text", "label": "自定义", "class": "android.widget.Switch"},
        {"type": "tap_labeled_editable", "label": "模型 ID"},
        {"type": "text", "value": "linecode-test-model"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_text", "value": "测试"},
        {"type": "sleep", "seconds": 1.2},
        {"type": "expect_text", "value": "测试失败："},
        {"type": "expect_text", "value": "ms)"}
      ]
    },
    {
      "name": "model_create_and_save",
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "自定义模型"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_labeled_editable", "label": "名称"},
        {"type": "text", "value": "LifecycleModel"},
        {"type": "tap_labeled_editable", "label": "Base URL"},
        {"type": "text", "value": "http://10.0.2.2:18080/v1"},
        {"type": "tap_labeled_editable", "label": "API Key"},
        {"type": "text", "value": "test-key"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_control_after_text", "label": "自定义", "class": "android.widget.Switch"},
        {"type": "expect_control_checked", "label": "自定义", "class": "android.widget.Switch", "value": true},
        {"type": "tap_labeled_editable", "label": "模型 ID"},
        {"type": "text", "value": "linecode-test-model"},
        {"type": "expect_labeled_editable_text", "label": "模型 ID", "value": "linecode-test-model"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_text", "value": "保存"},
        {"type": "sleep", "seconds": 1.2},
        {"type": "expect_text", "value": "LifecycleModel"},
        {"type": "expect_text", "value": "linecode-test-model"}
      ]
    },
    {
      "name": "model_cold_start_restore_and_select",
      "depends_on": ["model_create_and_save"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_text", "value": "LifecycleModel"},
        {"type": "expect_text", "value": "linecode-test-model"},
        {"type": "tap_text", "value": "LifecycleModel"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "keyevent", "key": "BACK"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "expect_text", "value": "输入消息…"},
        {"type": "expect_no_text", "value": "请先到设置 → 模型管理配置模型"}
      ]
    },
    {
      "name": "model_edit",
      "depends_on": ["model_cold_start_restore_and_select"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "long_press_text", "value": "LifecycleModel"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "修改"},
        {"type": "sleep", "seconds": 0.7},
        {"type": "expect_text", "value": "修改模型"},
        {"type": "expect_labeled_editable_text", "label": "名称", "value": "LifecycleModel"},
        {"type": "expect_labeled_editable_text", "label": "Base URL", "value": "http://10.0.2.2:18080/v1"},
        {"type": "expect_labeled_editable_text", "label": "模型 ID", "value": "linecode-test-model"},
        {"type": "replace_labeled_editable_text", "label": "名称", "value": "LifecycleEdited"},
        {"type": "expect_labeled_editable_text", "label": "名称", "value": "LifecycleEdited"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "tap_text", "value": "保存"},
        {"type": "sleep", "seconds": 1.2},
        {"type": "expect_text", "value": "LifecycleEdited"},
        {"type": "expect_no_text", "value": "LifecycleModel"}
      ]
    },
    {
      "name": "model_delete_confirmation",
      "depends_on": ["model_edit"],
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "long_press_text", "value": "LifecycleEdited"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "多选"},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "删除模型"},
        {"type": "expect_text", "value": "确定删除 1 个模型？"},
        {"type": "expect_text", "value": "删除后需要重新添加才能使用"},
        {"type": "expect_text", "value": "取消"},
        {"type": "expect_text", "value": "删除"}
      ]
    },
    {
      "name": "model_delete",
      "depends_on": ["model_delete_confirmation"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "long_press_text", "value": "LifecycleEdited"},
        {"type": "sleep", "seconds": 0.5},
        {"type": "tap_text", "value": "多选"},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.5},
        {"type": "expect_text", "value": "删除模型"},
        {"type": "tap_text", "value": "删除"},
        {"type": "sleep", "seconds": 1.0},
        {"type": "expect_text", "value": "还没有模型"},
        {"type": "expect_no_text", "value": "LifecycleEdited"}
      ]
    },
    {
      "name": "model_delete_cold_start_restore",
      "depends_on": ["model_delete"],
      "compare_pixels": false,
      "actions": [
        {"type": "tap", "x": 1005, "y": 205},
        {"type": "sleep", "seconds": 0.4},
        {"type": "tap_text", "value": "设置"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "tap_text", "value": "模型管理"},
        {"type": "sleep", "seconds": 0.8},
        {"type": "expect_text", "value": "还没有模型"},
        {"type": "expect_no_text", "value": "LifecycleEdited"},
        {"type": "keyevent", "key": "BACK"},
        {"type": "sleep", "seconds": 0.6},
        {"type": "expect_text", "value": "请先到设置 → 模型管理配置模型"}
      ]
    }
  ]
}
